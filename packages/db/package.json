{
  "name": "@belo-ramo/db",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "seed": "tsx --env-file=../../.env prisma/seed.ts",
    "reset": "prisma db push --force-reset && pnpm seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
