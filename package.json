{
  "name": "belo-ramo-crm",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @belo-ramo/db generate",
    "db:push": "pnpm --filter @belo-ramo/db push",
    "db:seed": "pnpm --filter @belo-ramo/db seed",
    "db:reset": "pnpm --filter @belo-ramo/db reset"
  }
}
